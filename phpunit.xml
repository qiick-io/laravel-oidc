<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory>tests</directory>
            <!-- Synced app-level checks require a product application. Packages run tests/Erasure. -->
            <exclude>tests/Conformance</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Needs a running Keycloak: KEYCLOAK_URL=http://localhost:8080 vendor/bin/pest with the group option set to keycloak -->
            <group>keycloak</group>
<!-- Needs a running Zitadel: ZITADEL_URL=… vendor/bin/pest with the group option set to zitadel -->
            <group>zitadel</group>
            <!-- Needs a running Signaculum: SIGNACULUM_URL=… vendor/bin/pest with the group option set to signaculum -->
            <group>signaculum</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
