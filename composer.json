{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "qiick/laravel-oidc",
    "description": "OpenID Connect client for Laravel: PKCE, id_token validation, logout, role mapping. Works with any IdP.",
    "type": "library",
    "keywords": [
        "qiick",
        "laravel",
        "oidc",
        "openid-connect",
        "sso",
        "pkce",
        "keycloak",
        "entra-id"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Qiick",
            "homepage": "https://qiick.io"
        }
    ],
    "homepage": "https://github.com/qiick-io/laravel-oidc",
    "support": {
        "issues": "https://github.com/qiick-io/laravel-oidc/issues",
        "source": "https://github.com/qiick-io/laravel-oidc"
    },
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.3.1",
        "laravel/pint": "^1.30.4 <1.31.0",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1.11"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qiick\\Oidc\\Laravel\\OidcServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Qiick\\Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qiick\\Oidc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
